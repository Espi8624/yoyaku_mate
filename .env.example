# ESLintプラグインの無効化設定
DISABLE_ESLINT_PLUGIN='true'

# リアルタイム待機列APIサーバーのアドレス (ローカル起動のGoサーバー)
REACT_APP_API_URL='http://localhost:8080/api'

# Google Maps APIキー (クライアント用キーの発行が必要)
REACT_APP_GOOGLE_MAPS_API_KEY='YOUR_GOOGLE_MAPS_API_KEY'

# 注意: Gemini APIキーはここに置かない。
# REACT_APP_* はビルド時にバンドルへ文字列として埋め込まれ、誰でも取り出せるため、
# 翻訳・チャットボットはサーバー(yoyaku_mate_server)経由で呼び出す。
